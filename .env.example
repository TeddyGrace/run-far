# --- Database ---
DATABASE_URL=postgres://runfar:runfar@localhost:5432/runfar

# --- App / session ---
NODE_ENV=development
API_PORT=8787
WEB_ORIGIN=http://localhost:5174
SESSION_SECRET=replace-with-a-long-random-string
# 32-byte key, base64-encoded, used for AES-256-GCM token encryption. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# --- Whoop OAuth (https://developer.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8787/api/whoop/oauth/callback
# HMAC secret used to verify inbound webhooks; same as WHOOP_CLIENT_SECRET per Whoop's docs.
WHOOP_WEBHOOK_SECRET=

# --- Google Calendar OAuth (https://console.cloud.google.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/oauth/callback
# Publicly reachable HTTPS URL for push notifications (use a tunnel in dev, e.g. cloudflared/ngrok).
GOOGLE_WEBHOOK_URL=

# --- TrainingPeaks ---
# No API access exists for personal accounts; plans are imported via CSV upload (see Phase 3).
