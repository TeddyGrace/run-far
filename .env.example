# --- Database ---
DATABASE_URL=postgres://runfar:runfar@localhost:5432/runfar

# --- App / session ---
NODE_ENV=development
API_PORT=8787
WEB_ORIGIN=http://localhost:5174
SESSION_SECRET=replace-with-a-long-random-string
# 32-byte key, base64-encoded, used for AES-256-GCM token encryption. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# --- Whoop OAuth (https://developer.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8787/api/whoop/oauth/callback
# HMAC secret used to verify inbound webhooks; same as WHOOP_CLIENT_SECRET per Whoop's docs.
WHOOP_WEBHOOK_SECRET=

# --- Google OAuth (https://console.cloud.google.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Standalone Calendar connect (Settings → Google), used to repair a revoked connection.
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/oauth/callback
# Sign in with Google — also grants Calendar. Add this as an authorized redirect URI too.
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
# Publicly reachable HTTPS URL for push notifications (use a tunnel in dev, e.g. cloudflared/ngrok).
GOOGLE_WEBHOOK_URL=

# --- Email (Resend: https://resend.com) ---
# All transactional email (signup verification, password reset, access-approved, and the
# daily recovery digest) sends via Resend from MAIL_FROM. In development, leaving this unset
# just logs each email (with its verify/reset URL) instead of sending — no key needed to
# exercise those flows locally. In production, an unset key means email doesn't send.
RESEND_API_KEY=
MAIL_FROM=Run Far <noreply@mail.run-far.cc>
# Optional — set to a real inbox so replies to auth mail reach a person.
MAIL_REPLY_TO=

# --- Anthropic (Build → Describe your own) ---
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-5 (alias → latest dated snapshot).
# Pin a snapshot for production, e.g. claude-sonnet-4-5-20250929, or use claude-opus-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-5
# IANA timezone used when the coach schedules run start times (default America/New_York).
# Fallback only — each signed-in user's own timezone (captured from their browser at login)
# takes precedence; see apps/api/src/lib/athleteTimezone.ts.
ATHLETE_TIMEZONE=America/New_York
# Contact email NWS shows in the API's User-Agent header (the app operator, not any athlete).
NWS_CONTACT_EMAIL=teddygrace77@gmail.com

# --- Access control ---
# Comma-separated emails allowed to CREATE an account via Google sign-in (existing accounts
# are unaffected). Empty allows anyone to sign up in development; in production, empty means
# nobody can — set this before deploying if you want any signups at all. The backoffice
# (below) is the preferred way to manage this list now; ALLOWED_EMAILS still works too.
ALLOWED_EMAILS=

# Comma-separated break-glass admin list, reconciled into the users table on every boot. The
# admin role is otherwise granted only by data migration, so without this a deleted or
# disabled admin locks the backoffice permanently. Additive only: it grants admin (and
# re-approves, re-verifies, un-disables) but never demotes anyone left off the list, and it
# authenticates nobody by itself — sign-in still goes through the normal login. If the
# account row is gone entirely, the invite is re-seeded so you can sign up again; the next
# boot then promotes the new row.
ADMIN_EMAILS=

# --- Backoffice (backoffice.run-far.cc) ---
# Widens the session cookie to this parent domain so a login on the main site also works on
# the backoffice subdomain. Leave unset in development. In production, set to ".run-far.cc".
COOKIE_DOMAIN=
# Host the backoffice SPA is served on (Fastify host constraint in server.ts).
BACKOFFICE_HOSTNAME=backoffice.run-far.cc

# --- TrainingPeaks ---
# No API access exists for personal accounts; plans can still be imported via CSV on the Build tab.

# --- Railway notes ---
# On Railway, link a Postgres plugin (injects DATABASE_URL) and set:
#   NODE_ENV=production
#   SESSION_SECRET / ENCRYPTION_KEY (required)
#   WHOOP_* / GOOGLE_* / RESEND_API_KEY / ANTHROPIC_API_KEY as needed
# WEB_ORIGIN and OAuth redirect URIs default from RAILWAY_PUBLIC_DOMAIN when unset.
# Still register those HTTPS callback + webhook URLs in the Whoop/Google consoles.
