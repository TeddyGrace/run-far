# --- Database ---
DATABASE_URL=postgres://runfar:runfar@localhost:5432/runfar

# --- App / session ---
NODE_ENV=development
API_PORT=8787
WEB_ORIGIN=http://localhost:5174
SESSION_SECRET=replace-with-a-long-random-string
# 32-byte key, base64-encoded, used for AES-256-GCM token encryption. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# --- Whoop OAuth (https://developer.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8787/api/whoop/oauth/callback
# HMAC secret used to verify inbound webhooks; same as WHOOP_CLIENT_SECRET per Whoop's docs.
WHOOP_WEBHOOK_SECRET=

# --- Google OAuth (https://console.cloud.google.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Standalone Calendar connect (Settings → Google), used to repair a revoked connection.
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/oauth/callback
# Sign in with Google — also grants Calendar. Add this as an authorized redirect URI too.
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
# Publicly reachable HTTPS URL for push notifications (use a tunnel in dev, e.g. cloudflared/ngrok).
GOOGLE_WEBHOOK_URL=

# --- Anthropic (Build → Describe your own) ---
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-5 (alias → latest dated snapshot).
# Pin a snapshot for production, e.g. claude-sonnet-4-5-20250929, or use claude-opus-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-5
# IANA timezone used when the coach schedules run start times (default America/New_York).
ATHLETE_TIMEZONE=America/New_York

# --- TrainingPeaks ---
# No API access exists for personal accounts; plans can still be imported via CSV on the Build tab.

# --- Railway notes ---
# On Railway, link a Postgres plugin (injects DATABASE_URL) and set:
#   NODE_ENV=production
#   SESSION_SECRET / ENCRYPTION_KEY (required)
#   WHOOP_* / GOOGLE_* / ANTHROPIC_API_KEY as needed
# WEB_ORIGIN and OAuth redirect URIs default from RAILWAY_PUBLIC_DOMAIN when unset.
# Still register those HTTPS callback + webhook URLs in the Whoop/Google consoles.
