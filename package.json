{
  "name": "run-far",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @run-far/api --filter @run-far/web --filter @run-far/backoffice run dev",
    "dev:api": "pnpm --filter @run-far/api run dev",
    "dev:web": "pnpm --filter @run-far/web run dev",
    "dev:backoffice": "pnpm --filter @run-far/backoffice run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "db:generate": "pnpm --filter @run-far/api run db:generate",
    "db:migrate": "pnpm --filter @run-far/api run db:migrate",
    "db:seed": "pnpm --filter @run-far/api run db:seed",
    "db:studio": "pnpm --filter @run-far/api run db:studio",
    "db:start": "scripts/pg.sh start",
    "db:stop": "scripts/pg.sh stop",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0"
  }
}
