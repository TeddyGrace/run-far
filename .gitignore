# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env / secrets — never commit real credentials
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Test / coverage
coverage/
.vitest/

# Vite
apps/web/dist/
apps/web/.vite/

# Uploaded TrainingPeaks files — user data, not source
apps/api/uploads/

# Note: drizzle/ (migration SQL + meta) IS committed intentionally — it's the
# migration history and drizzle-kit needs the meta snapshots to diff future changes.

# Turbo/Nx-style caches, if ever introduced
.turbo/
.cache/

# Local Postgres data directory (dev convenience; not portable, not source)
.pgdata/

# iOS (Capacitor). The generated Xcode project at apps/web/ios IS committed
# intentionally — it carries the HealthKit capability and the Info.plist purpose
# strings, which are hand-edited and can't be regenerated (see docs/ios.md).
# What's excluded is everything derived from it or from `cap sync`.
apps/web/ios/App/Pods/
apps/web/ios/App/Podfile.lock
apps/web/ios/App/App/public/
apps/web/ios/App/App/capacitor.config.json
apps/web/ios/App/public/
apps/web/DerivedData/
*.xcuserstate
xcuserdata/
